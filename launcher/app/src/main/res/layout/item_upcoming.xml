<?xml version="1.0" encoding="utf-8"?>
<!-- One Coming next row: date, show, episode. Colours flip when focused (selectors + duplicateParentState). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/date"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:textColor="@drawable/row_text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500" />

    <TextView
        android:id="@+id/show"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@drawable/pill_text"
        android:textSize="16sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500" />

    <TextView
        android:id="@+id/episode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@drawable/row_text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
