<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.disney.disneyplus</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- Apps never listed under Continue watching (stores, settings and other non-media apps). -->
    <string-array name="continue_exclude">
        <item>com.android.vending</item>
        <item>com.android.tv.settings</item>
        <item>com.droidlogic.tv.settings</item>
        <item>com.google.android.apps.tv.launcherx</item>
        <item>com.google.android.tungsten.setupwraith</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to detect it:
         it's only offered on TVs with a built-in tuner (not on dongles). -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- Live TV apps tried, in order, when a built-in tuner is found and no app opens the channel list. -->
    <string-array name="live_tv_candidates">
        <item>com.google.android.tv</item>
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.sony.dtv.tvx</item>
    </string-array>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>
</resources>
